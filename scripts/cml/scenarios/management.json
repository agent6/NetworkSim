      "node": "probe",
      "command": "NetSimLab42!",
      "expect": [
        "IOSXE>\\s*$"
      ],
      "sensitive": true
    },
    {
      "id": "iosxe-telnet-exit",
      "node": "probe",
      "command": "exit",
      "expect": [
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "iosxe-local-1",
      "node": "iosxe",
      "command": "configure terminal"
    },
    {
      "id": "iosxe-local-2",
      "node": "iosxe",
