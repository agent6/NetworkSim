        "ip router ospf LAB area 0",
        "no shutdown",
        "exit",
        "interface Ethernet1/3",
        "no switchport",
        "ip address 198.51.100.1/30",
        "ipv6 address 2001:db8:12::1/64",
        "ip router ospf LAB area 0",
        "no shutdown",
        "exit",
        "ipv6 route ::/0 2001:db8:12::2",
        "end"
