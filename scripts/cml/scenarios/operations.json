    {
      "id": "iosxe",
      "kind": "router",
      "hostname": "IOSXE",
      "cml": {
        "definition": "iol-xe",
        "image": "iol-xe-17-18-02",
        "port": "Ethernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname IOSXE",
        "no ip domain-lookup",
        "ipv6 unicast-routing",
        "lldp run",
        "interface Ethernet0/0",
        "ip address 198.51.100.2 255.255.255.252",
        "ipv6 address 2001:db8:12::2/64",
        "ip nat inside",
        "no shutdown",
        "exit",
        "interface Ethernet0/1",
        "ip address 203.0.113.1 255.255.255.0",
        "ipv6 address 2001:db8:203::1/64",
        "ip nat outside",
        "no shutdown",
        "exit",
        "ip route 0.0.0.0 0.0.0.0 203.0.113.2",
        "ipv6 route 2001:db8:10::/64 2001:db8:12::1",
        "ipv6 route 2001:db8:9::9/128 2001:db8:203::2",
        "router ospf 1",
        "router-id 3.3.3.3",
        "network 198.51.100.0 0.0.0.3 area 0",
        "default-information originate",
        "exit",
        "access-list 10 permit 10.10.10.0 0.0.0.255",
        "ip nat inside source list 10 interface Ethernet0/1 overload",
        "ip access-list extended OBSERVE",
        "permit icmp 10.10.10.0 0.0.0.255 any",
        "permit ip any any",
        "exit",
        "interface Ethernet0/0",
        "ip access-group OBSERVE in",
        "exit",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOSXE",
        "no ip domain-lookup",
