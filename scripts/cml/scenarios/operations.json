        "no shutdown",
        "exit",
        "ip route 0.0.0.0 0.0.0.0 203.0.113.2",
        "ipv6 route 2001:db8:10::/64 2001:db8:12::1",
        "ipv6 route 2001:db8:9::9/128 2001:db8:203::2",
        "router ospf 1",
        "router-id 3.3.3.3",
        "network 198.51.100.0 0.0.0.3 area 0",
