{
  "schemaVersion": 1,
  "id": "operational-show-commands",
  "description": "Read-only command survey plus live OSPF, STP, discovery, IPv4 PAT/ACL and routed IPv6 state. No external connectors.",
  "nodes": [
    {
      "id": "ios",
      "kind": "router",
      "hostname": "IOS",
      "cml": {
        "definition": "iosv",
        "image": "iosv-159-3-m12",
        "port": "GigabitEthernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname IOS",
        "no ip domain-lookup",
        "ipv6 unicast-routing",
        "lldp run",
        "interface GigabitEthernet0/0",
        "ip address 10.10.10.10 255.255.255.0",
        "ipv6 address 2001:db8:10::10/64",
        "no shutdown",
        "exit",
        "router ospf 1",
        "router-id 1.1.1.1",
        "network 10.10.10.0 0.0.0.255 area 0",
        "exit",
        "ipv6 route ::/0 2001:db8:10::1",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOS",
        "no ip domain-lookup",
        "ipv6 unicast-routing",
