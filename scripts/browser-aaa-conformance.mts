 await services();await page.waitForFunction(()=>document.querySelector('[data-aaa-accounting]')?.textContent?.includes('command=description AAA-GUI-ROLE'));await page.screenshot({path:folder+'/light.png'});await close();await page.locator('[data-action=toggle-theme]').click();await node('SRV1').dblclick();await page.locator('[data-desktop=services]').click();await page.locator('[data-service-tab=AAA]').click();await page.screenshot({path:folder+'/dark.png'});assert.equal(await page.locator('select[name=tacacs-role]').nth(1).inputValue(),'network-admin');checks.push('AAA controls and receiver log persist in light and dark views');
 assert.deepEqual(errors,[]);assert.deepEqual(requests,[]);await writeFile(folder+'/result.json',JSON.stringify({browser:await browser.version(),artifactSha256:createHash('sha256').update(await readFile('index.html')).digest('hex'),checks,errors,httpRequests:requests},null,2)+'\n');console.log(JSON.stringify(checks));
}catch(error){await page.screenshot({path:folder+'/failure.png'});throw error;}finally{await browser.close();}
