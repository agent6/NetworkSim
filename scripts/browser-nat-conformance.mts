 for(const line of ['configure terminal','no ip nat inside source static 192.168.20.10 198.51.100.10','ip access-list NAT-INSIDE','10 permit ip 192.168.20.0/24 any','exit','ip nat pool PUBLIC 198.51.100.10 198.51.100.11 prefix-length 24','ip nat inside source list NAT-INSIDE pool PUBLIC overload','end'])assert.doesNotMatch(await command(line),/% (?:Invalid|Incomplete)/);
 await page.locator('[data-action=close-dock]').click();await pc('I2');assert.match(await command('ping -n 1 198.51.100.100'),/Received = 1/);await page.locator('[data-action=close-dock]').click();await node('NX').dblclick();assert.match(await command('show ip nat translations'),/icmp\s+198\.51\.100\.1[01]:/);checks.push('Nexus named-ACL pool PAT forwards Windows traffic and displays the allocated pool address');
 await command('configure terminal');await command('no ip nat inside source list NAT-INSIDE pool PUBLIC overload');assert.match(await page.locator('#terminal-prompt').textContent(),/Continue\? \(y\/n\)/);await command('y');await command('ip nat inside source list NAT-INSIDE interface Ethernet1/2 overload');await command('end');
 await page.locator('[data-action=close-dock]').click();await pc('I2');assert.match(await command('ping -n 1 198.51.100.100'),/Received = 1/);await page.locator('[data-action=close-dock]').click();await node('NX').dblclick();assert.match(await command('show ip nat translations'),/icmp\s+198\.51\.100\.1:/);checks.push('Nexus live policy confirmation and interface PAT work through the UI');
 await page.locator('[data-action=close-dock]').click();await node('I1').dblclick();await page.locator('[data-desktop=browser]').click();await page.locator('#browser-url').fill('http://203.0.113.100');await page.locator('#browser-form').evaluate((f:HTMLFormElement)=>f.requestSubmit());await page.waitForFunction(()=>document.querySelector('#browser-status')?.textContent?.includes('200'));await close();checks.push('Simulated HTTP traverses PAT without a real network request');
