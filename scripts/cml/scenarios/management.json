{
  "schemaVersion": 1,
  "id": "management-vty-ssh",
  "description": "IOS, IOS XE and NX-OS management behavior over isolated links. Synthetic lab credentials only.",
  "nodes": [
    {
      "id": "ios",
      "kind": "router",
      "hostname": "IOS",
      "cml": {
        "definition": "iosv",
        "image": "iosv-159-3-m12",
        "port": "GigabitEthernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname IOS",
        "no ip domain-lookup",
        "interface range GigabitEthernet0/0 - 3",
        "no ip address",
        "shutdown",
        "exit",
        "interface ${port}",
        "ip address 192.0.2.1 255.255.255.0",
        "no shutdown",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOS",
        "no ip domain-lookup",
        "interface ${port}",
        "ip address 192.0.2.1 255.255.255.0",
        "no shutdown",
        "end"
      ]
    },
    {
      "id": "iosxe",
      "kind": "router",
      "hostname": "IOSXE",
      "cml": {
        "definition": "iol-xe",
        "image": "iol-xe-17-18-02",
        "port": "Ethernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname IOSXE",
        "no ip domain lookup",
        "interface range Ethernet0/0 - 3",
        "no ip address",
        "shutdown",
        "exit",
        "interface Ethernet0/0",
        "ip address 198.51.100.1 255.255.255.0",
        "no shutdown",
        "exit",
        "interface Ethernet0/1",
        "ip address 198.18.0.1 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 203.0.113.0 255.255.255.0 198.51.100.2",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOSXE",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        "ip address 198.51.100.1 255.255.255.0",
        "no shutdown",
        "exit",
        "interface GigabitEthernet0/1",
        "ip address 198.18.0.1 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 203.0.113.0 255.255.255.0 198.51.100.2",
        "end"
      ],
      "portMap": {
        "Ethernet0/0": "GigabitEthernet0/0",
        "Ethernet0/1": "GigabitEthernet0/1"
      }
    },
    {
      "id": "nxos",
      "kind": "datacenter",
      "hostname": "NEXUS",
      "cml": {
        "definition": "nxosv9000",
        "image": "nxosv9300-10-6-2-f",
        "port": "Ethernet1/1"
      },
      "simPort": "Ethernet1/1",
      "startup": [
        "hostname NEXUS",
        "no password strength-check",
        "username admin password NetSimLab42! role network-admin",
        "interface ${port}",
        "no switchport",
        "ip address 203.0.113.1/24",
        "no shutdown",
        "exit",
        "ip route 198.51.100.0/24 203.0.113.2",
        "end"
      ],
      "simulatorSetup": [
        "configure terminal",
        "hostname NEXUS",
        "username admin password NetSimLab42! role network-admin",
        "interface ${port}",
        "no switchport",
        "ip address 203.0.113.1/24",
        "no shutdown",
        "exit",
        "ip route 198.51.100.0/24 203.0.113.2",
        "end"
      ]
    },
    {
      "id": "probe",
      "kind": "router",
      "hostname": "PROBE",
      "cml": {
        "definition": "iosv",
        "image": "iosv-159-3-m12",
        "port": "GigabitEthernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname PROBE",
        "no ip domain-lookup",
        "interface range GigabitEthernet0/0 - 3",
        "no ip address",
        "shutdown",
        "exit",
        "interface GigabitEthernet0/0",
        "ip address 192.0.2.2 255.255.255.0",
        "no shutdown",
        "exit",
        "interface GigabitEthernet0/1",
        "ip address 198.51.100.2 255.255.255.0",
        "no shutdown",
        "exit",
        "interface GigabitEthernet0/2",
        "ip address 203.0.113.2 255.255.255.0",
        "no shutdown",
        "exit",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname PROBE",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        "ip address 192.0.2.2 255.255.255.0",
        "no shutdown",
        "exit",
        "interface GigabitEthernet0/1",
        "ip address 198.51.100.2 255.255.255.0",
        "no shutdown",
        "exit",
        "interface GigabitEthernet0/2",
        "ip address 203.0.113.2 255.255.255.0",
        "no shutdown",
        "exit",
        "end"
      ]
    },
    {
      "id": "sshprobe",
      "kind": "router",
      "hostname": "SSH-PROBE",
      "cml": {
        "definition": "iol-xe",
        "image": "iol-xe-17-18-02",
        "port": "Ethernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname SSH-PROBE",
        "no ip domain lookup",
        "interface range Ethernet0/0 - 3",
        "no ip address",
        "shutdown",
        "exit",
        "interface Ethernet0/0",
        "ip address 198.18.0.2 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 198.51.100.0 255.255.255.0 198.18.0.1",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname SSH-PROBE",
        "interface GigabitEthernet0/0",
        "ip address 198.18.0.2 255.255.255.0",
        "no shutdown",
        "exit",
        "ip route 198.51.100.0 255.255.255.0 198.18.0.1",
        "end"
      ]
    }
  ],
  "links": [
    [
      {
        "node": "ios",
        "port": "GigabitEthernet0/0"
      },
      {
        "node": "probe",
        "port": "GigabitEthernet0/0"
      }
    ],
    [
      {
        "node": "iosxe",
        "port": "Ethernet0/0"
      },
      {
        "node": "probe",
        "port": "GigabitEthernet0/1"
      }
    ],
    [
      {
        "node": "nxos",
        "port": "Ethernet1/1"
      },
      {
        "node": "probe",
        "port": "GigabitEthernet0/2"
      }
    ],
    [
      {
        "node": "iosxe",
        "port": "Ethernet0/1"
      },
      {
        "node": "sshprobe",
        "port": "Ethernet0/0"
      }
    ]
  ],
  "steps": [
    {
      "id": "ios-factory-lines",
      "node": "ios",
      "command": "show running-config | section line"
    },
    {
      "id": "ios-warm-arp",
      "node": "probe",
      "command": "ping 192.0.2.1 repeat 2"
    },
    {
      "id": "ios-reachable",
      "node": "probe",
      "command": "ping 192.0.2.1 repeat 2",
      "expect": [
        "Success rate is 100 percent"
      ]
    },
    {
      "id": "ios-factory-telnet",
      "node": "probe",
      "command": "telnet 192.0.2.1",
      "expect": [
        "(?:refused|Password required, but none set)",
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-select-line-1",
      "node": "ios",
      "command": "configure terminal"
    },
    {
      "id": "ios-select-line-2",
      "node": "ios",
      "command": "line vty 0 4"
    },
    {
      "id": "ios-select-line-3",
      "node": "ios",
      "command": "transport input all"
    },
    {
      "id": "ios-select-line-4",
      "node": "ios",
      "command": "end"
    },
    {
      "id": "ios-all-still-needs-password",
      "node": "probe",
      "command": "telnet 192.0.2.1",
      "expect": [
        "Password required, but none set",
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-line-password-1",
      "node": "ios",
      "command": "configure terminal"
    },
    {
      "id": "ios-line-password-2",
      "node": "ios",
      "command": "line vty 0 4"
    },
    {
      "id": "ios-line-password-3",
      "node": "ios",
      "command": "password NetSimLab42!"
    },
    {
      "id": "ios-line-password-4",
      "node": "ios",
      "command": "login"
    },
    {
      "id": "ios-line-password-5",
      "node": "ios",
      "command": "end"
    },
    {
      "id": "ios-telnet-password-prompt",
      "node": "probe",
      "command": "telnet 192.0.2.1",
      "expect": [
        "Password:\\s*$"
      ]
    },
    {
      "id": "ios-telnet-login",
      "node": "probe",
      "command": "NetSimLab42!",
      "expect": [
        "IOS>\\s*$"
      ],
      "sensitive": true
    },
    {
      "id": "ios-telnet-exit",
      "node": "probe",
      "command": "exit",
      "expect": [
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-local-1",
      "node": "ios",
      "command": "configure terminal"
    },
    {
      "id": "ios-local-2",
      "node": "ios",
      "command": "username admin privilege 15 secret NetSimLab42!"
    },
    {
      "id": "ios-local-3",
      "node": "ios",
      "command": "line vty 0 4"
    },
    {
      "id": "ios-local-4",
      "node": "ios",
      "command": "login local"
    },
    {
      "id": "ios-local-5",
      "node": "ios",
      "command": "end"
    },
    {
      "id": "ios-local-username",
      "node": "probe",
      "command": "telnet 192.0.2.1",
      "expect": [
        "Username:\\s*$"
      ]
    },
    {
      "id": "ios-local-password",
      "node": "probe",
      "command": "admin",
      "expect": [
        "Password:\\s*$"
      ]
    },
    {
      "id": "ios-local-auth",
      "node": "probe",
      "command": "NetSimLab42!",
      "expect": [
        "IOS#\\s*$"
      ],
      "sensitive": true
    },
    {
      "id": "ios-local-exit",
      "node": "probe",
      "command": "exit",
      "expect": [
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-ssh-setup-1",
      "node": "ios",
      "command": "configure terminal"
    },
    {
      "id": "ios-ssh-setup-2",
      "node": "ios",
      "command": "ip domain-name cml.test"
    },
    {
      "id": "ios-ssh-setup-3",
      "node": "ios",
      "command": "crypto key generate rsa modulus 2048"
    },
    {
      "id": "ios-ssh-setup-4",
      "node": "ios",
      "command": "ip ssh version 2"
    },
    {
      "id": "ios-ssh-setup-5",
      "node": "ios",
      "command": "line vty 0 4"
    },
    {
      "id": "ios-ssh-setup-6",
      "node": "ios",
      "command": "transport input ssh"
    },
    {
      "id": "ios-ssh-setup-7",
      "node": "ios",
      "command": "end"
    },
    {
      "id": "ios-telnet-disabled",
      "node": "probe",
      "command": "telnet 192.0.2.1",
      "expect": [
        "refused",
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-ssh-password",
      "node": "probe",
      "command": "ssh -l admin 192.0.2.1",
      "expect": [
        "Password:\\s*$"
      ],
      "timeout": 90
    },
    {
      "id": "ios-ssh-login",
      "node": "probe",
      "command": "NetSimLab42!",
      "expect": [
        "IOS#\\s*$"
      ],
      "sensitive": true
    },
    {
      "id": "ios-ssh-identity",
      "node": "probe",
      "command": "show privilege",
      "expect": [
        "Current privilege level is 15"
      ]
    },
    {
      "id": "ios-ssh-exit",
      "node": "probe",
      "command": "exit",
      "expect": [
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "ios-reset-transport-1",
      "node": "ios",
      "command": "configure terminal"
    },
    {
      "id": "ios-reset-transport-2",
      "node": "ios",
      "command": "line vty 0 4"
    },
    {
      "id": "ios-reset-transport-3",
      "node": "ios",
      "command": "default transport input"
    },
    {
      "id": "ios-reset-transport-4",
      "node": "ios",
      "command": "end"
    },
    {
      "id": "ios-default-lines",
      "node": "ios",
      "command": "show running-config | section line"
    },
    {
      "id": "iosxe-factory-lines",
      "node": "iosxe",
      "command": "show running-config | section line"
    },
    {
