      "id": "IOS",
      "kind": "switch",
      "hostname": "IOS",
      "cml": {
        "definition": "iosvl2",
        "image": "iosvl2-2020",
        "port": "GigabitEthernet0/1"
      },
      "simPort": "GigabitEthernet0/1",
      "startup": [
        "hostname IOS",
        "hostname IOS",
        "no cdp run",
        "vlan 10",
        "exit",
        "interface GigabitEthernet0/1",
        "switchport mode access",
        "switchport access vlan 10",
        "spanning-tree portfast",
        "switchport nonegotiate",
        "no shutdown",
        "interface Vlan10",
        "ip address 10.42.0.1 255.255.255.0",
        "no shutdown",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOS",
        "no cdp run",
        "vlan 10",
        "exit",
