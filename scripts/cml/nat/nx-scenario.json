  "steps": [
    {
      "id": "nx-nat-001",
      "kind": "config",
      "node": "NX",
      "commands": [
        "configure terminal",
        "feature nat",
        "interface Ethernet1/1",
        "ip nat inside",
        "interface Ethernet1/2",
        "ip nat outside",
        "ip nat inside source static 192.168.20.10 198.51.100.10",
        "end"
      ]
    },
    {
      "id": "nx-nat-002",
      "kind": "probe",
      "node": "I2",
      "protocol": "icmp",
      "source": "192.168.20.10",
      "destination": "198.51.100.100",
      "token": "nx-static-icmp-False",
      "sourcePort": 44410,
      "success": true,
      "observedSource": "198.51.100.10"
    },
    {
