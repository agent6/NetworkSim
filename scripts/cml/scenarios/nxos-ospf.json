      "hostname": "IOSXE",
      "cml": {
        "definition": "iol-xe",
        "image": "iol-xe-17-18-02",
        "port": "Ethernet0/0"
      },
      "simPort": "GigabitEthernet0/0",
      "startup": [
        "hostname IOSXE",
        "no ip domain-lookup",
        "interface Ethernet0/0",
        "ip address 198.51.100.2 255.255.255.252",
        "no shutdown",
        "exit",
        "interface Loopback0",
        "ip address 192.0.2.2 255.255.255.255",
        "exit",
        "router ospf 1",
        "router-id 3.3.3.3",
        "network 198.51.100.0 0.0.0.3 area 0",
        "network 192.0.2.2 0.0.0.0 area 0",
        "end"
      ],
      "simulatorSetup": [
        "enable",
        "configure terminal",
        "hostname IOSXE",
        "no ip domain-lookup",
        "interface GigabitEthernet0/0",
        "ip address 198.51.100.2 255.255.255.252",
        "no shutdown",
        "exit",
        "interface Loopback0",
        "ip address 192.0.2.2 255.255.255.255",
        "exit",
        "router ospf 1",
        "router-id 3.3.3.3",
        "network 198.51.100.0 0.0.0.3 area 0",
        "network 192.0.2.2 0.0.0.0 area 0",
        "end"
      ]
    }
  ],
