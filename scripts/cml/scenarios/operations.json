    {
      "id": "nxos",
      "kind": "datacenter",
      "hostname": "NEXUS",
      "cml": {
        "definition": "nxosv9000",
        "image": "nxosv9300-10-6-2-f",
        "port": "Ethernet1/1"
      },
      "simPort": "Ethernet1/1",
      "startup": [
        "hostname NEXUS",
        "no password strength-check",
        "username admin password NetSimLab42! role network-admin",
        "feature interface-vlan",
        "feature ospf",
        "feature lldp",
        "vlan 10",
        "name Users",
        "exit",
        "spanning-tree mode rapid-pvst",
        "spanning-tree vlan 10 priority 4096",
        "router ospf LAB",
        "router-id 2.2.2.2",
        "exit",
        "interface Ethernet1/1",
        "switchport",
        "switchport mode trunk",
        "switchport trunk allowed vlan 10",
        "no shutdown",
