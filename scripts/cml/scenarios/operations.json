  "steps": [
    {
      "id": "converged-ios-ospf",
      "node": "ios",
      "command": "show ip ospf neighbor",
      "waitSeconds": 90,
      "expect": [
        "2\\.2\\.2\\.2.*FULL"
      ]
    },
    {
      "id": "iosxe-ospf",
      "node": "iosxe",
      "command": "show ip ospf neighbor",
      "expect": [
        "2\\.2\\.2\\.2.*FULL"
      ]
    },
    {
      "id": "nxos-ospf",
      "node": "nxos",
      "command": "show ip ospf neighbors",
      "expect": [
        "1\\.1\\.1\\.1",
        "3\\.3\\.3\\.3",
        "FULL"
      ]
    },
    {
      "id": "warm-ipv4",
      "node": "ios",
      "command": "ping 192.0.2.9 repeat 2"
    },
    {
      "id": "routed-nat-icmp",
      "node": "ios",
      "command": "ping 192.0.2.9 repeat 5",
      "expect": [
        "Success rate is 100 percent"
      ]
    },
    {
      "id": "translated-flow",
      "node": "iosxe",
      "command": "show ip nat translations",
      "expect": [
        "icmp",
        "203\\.0\\.113\\.1",
        "10\\.10\\.10\\.10",
        "192\\.0\\.2\\.9"
      ]
    },
    {
      "id": "acl-hits",
      "node": "iosxe",
      "command": "show access-lists OBSERVE",
      "expect": [
        "matches"
      ]
    },
    {
      "id": "warm-ipv6",
      "node": "ios",
      "command": "ping 2001:db8:9::9 repeat 2"
    },
    {
      "id": "routed-ipv6",
      "node": "ios",
      "command": "ping 2001:db8:9::9 repeat 5",
      "expect": [
        "Success rate is 100 percent"
      ]
    },
    {
      "id": "nexus-root",
      "node": "nxos",
      "command": "show spanning-tree vlan 10",
      "expect": [
        "This bridge is the root"
      ]
    },
    {
      "id": "switch-alternate",
      "node": "switch",
      "command": "show spanning-tree vlan 10",
      "expect": [
        "Altn.*BLK"
      ]
    },
    {
      "id": "switch-learned",
      "node": "switch",
      "command": "show mac address-table dynamic vlan 10",
      "expect": [
        "DYNAMIC"
      ]
    },
    {
      "id": "nexus-discovery",
      "node": "nxos",
      "command": "show cdp neighbors detail",
      "expect": [
        "IOSXE",
        "SW"
      ]
    },
    {
      "id": "nexus-lldp",
      "node": "nxos",
      "command": "show lldp neighbors detail",
      "expect": [
        "System Name: IOSXE",
        "Management Address: 198\\.51\\.100\\.2"
      ]
    }
  ],
