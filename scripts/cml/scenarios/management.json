        "Password required, but none set",
        "PROBE#\\s*$"
      ]
    },
    {
      "id": "iosxe-line-password-1",
      "node": "iosxe",
      "command": "configure terminal"
    },
    {
      "id": "iosxe-line-password-2",
      "node": "iosxe",
      "command": "line vty 0 4"
    },
    {
      "id": "iosxe-line-password-3",
      "node": "iosxe",
      "command": "password NetSimLab42!"
    },
    {
      "id": "iosxe-line-password-4",
      "node": "iosxe",
      "command": "login"
    },
    {
      "id": "iosxe-line-password-5",
      "node": "iosxe",
      "command": "end"
