      "token": "nx-static-tcp-True",
      "sourcePort": 44410,
      "success": true,
      "observedSource": "198.51.100.100"
    },
    {
      "id": "nx-nat-008",
      "kind": "survey",
      "node": "NX",
      "commands": [
        "show ip nat translations verbose",
        "show ip nat statistics",
        "show ip nat-alias",
        "show running-config nat"
      ]
    },
    {
      "id": "nx-nat-009",
      "kind": "config",
      "node": "NX",
      "commands": [
        "clear ip nat translation all",
        "configure terminal",
        "no ip nat inside source static 192.168.20.10 198.51.100.10",
        "ip access-list NAT-INSIDE",
        "10 permit ip 192.168.20.0/24 any",
        "exit",
        "ip nat pool PUBLIC 198.51.100.10 198.51.100.11 prefix-length 24",
        "ip nat inside source list NAT-INSIDE pool PUBLIC overload",
        "end"
      ]
    },
    {
      "id": "nx-nat-010",
      "kind": "probe",
      "node": "I2",
      "protocol": "udp",
      "source": "192.168.20.10",
      "destination": "198.51.100.100",
      "sourcePort": 44500,
      "token": "nx-pool-overload-udp-10",
      "success": true,
      "observedRange": [
        "198.51.100.10",
        "198.51.100.11"
      ]
    },
