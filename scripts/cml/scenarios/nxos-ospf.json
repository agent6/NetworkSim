{
  "schemaVersion": 1,
  "id": "nxos-ospf-cli",
  "description": "Packet-validated NX-OS CLI: passive defaults and interface precedence, loopback metrics, directional MTU ignore, OSPF selectors, and VRF migration/withdrawal/recovery on one pre-wired link.",
  "nodes": [
    {
      "id": "nxos",
      "kind": "datacenter",
      "hostname": "NEXUS",
      "cml": {
        "definition": "nxosv9000",
        "image": "nxosv9300-10-6-2-f",
        "port": "Ethernet1/1"
      },
      "simPort": "Ethernet1/1",
      "startup": [
        "hostname NEXUS",
        "no password strength-check",
        "username admin password NetSimLab42! role network-admin",
        "feature ospf",
        "router ospf LAB",
        "router-id 2.2.2.2",
        "exit",
        "interface Ethernet1/1",
        "no switchport",
        "ip address 198.51.100.1/30",
        "ip router ospf LAB area 0",
        "no shutdown",
        "exit",
        "interface Loopback0",
        "ip address 192.0.2.1/32",
        "ip router ospf LAB area 0",
        "end"
      ],
      "simulatorSetup": [
        "configure terminal",
        "hostname NEXUS",
        "username admin password NetSimLab42! role network-admin",
        "feature ospf",
        "router ospf LAB",
        "router-id 2.2.2.2",
        "exit",
        "interface Ethernet1/1",
        "no switchport",
        "ip address 198.51.100.1/30",
        "ip router ospf LAB area 0",
        "no shutdown",
        "exit",
        "interface Loopback0",
        "ip address 192.0.2.1/32",
        "ip router ospf LAB area 0",
        "end"
      ]
    },
    {
      "id": "iosxe",
